[Unit]
Description=sib Production Telegram Group Game Bot
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=sib
Group=sib
WorkingDirectory=/opt/sib
Environment="PATH=/opt/sib/venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=/opt/sib/.env
ExecStart=/opt/sib/venv/bin/python3 /opt/sib/bot.py
ExecReload=/bin/kill -HUP $MAINPID

# Restart configuration
Restart=always
RestartSec=5s

# Resource limits and process sandboxing
LimitNOFILE=65535
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

# Standard logging to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sib-bot

[Install]
WantedBy=multi-user.target
