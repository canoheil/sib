# ---------------------------------------------------------------------------
# sib (سیب) — Environment Configuration Template
# ---------------------------------------------------------------------------

# Telegram Bot Token (از BotFather دریافت شود)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# نام کاربری ربات تلگرام
TELEGRAM_BOT_USERNAME=sib_game_bot

# آیدی‌های عددی تلگرام مدیران ربات (با کاما جدا شوند، هرگز در سورس کد هاردکد نکنید)
TELEGRAM_ADMIN_IDS=123456789,987654321

# آدرس کانال رسمی سیب (برای دروازه عضویت اجباری)
OFFICIAL_CHANNEL_ID=@sib_official
OFFICIAL_CHANNEL_LINK=https://t.me/sib_official
MEMBERSHIP_CHECK_ENABLED=true

# دیتابیس ماریا دی‌بی (MariaDB)
# آدرس ناهمگام (برای اجرای ربات):
DATABASE_URL=mysql+asyncmy://sib:sib_password@127.0.0.1:3306/sib
# آدرس همگام (برای اجرای مایگریشن‌های Alembic):
DATABASE_SYNC_URL=mysql+pymysql://sib:sib_password@127.0.0.1:3306/sib

# تایم‌اوت‌های سیستم مسابقه و بازی‌ها (به ثانیه)
MATCHMAKING_TIMEOUT_SECONDS=600
ACCEPTANCE_TIMEOUT_SECONDS=120

# Anti-spam / Rate Limiting
RATE_LIMIT_MESSAGE_COUNT=10
RATE_LIMIT_MESSAGE_WINDOW=5
RATE_LIMIT_COMMAND_COUNT=3
RATE_LIMIT_COMMAND_WINDOW=10
RATE_LIMIT_WAKE_WORD_COUNT=2
RATE_LIMIT_WAKE_WORD_WINDOW=10
RATE_LIMIT_CALLBACK_COUNT=30
RATE_LIMIT_CALLBACK_WINDOW=5

HIGH_CARD_TIMEOUT=60
ROCK_PAPER_SCISSORS_TIMEOUT=60
TIC_TAC_TOE_TIMEOUT=60
CONNECT_FOUR_TIMEOUT=60
BATTLESHIP_TIMEOUT=90

# تنظیمات ریتینگ الو (Elo)
INITIAL_RATING=1500.0
ELO_K_FACTOR=32.0

# سطح لاگ (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
